{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "waybi-nz-routing",
  "account_id": "6b1d0dd4e6f7f30df92753cd1e2ee12d",
  "main": "worker.ts",
  "compatibility_date": "2026-08-04",
  "containers": [{
    "class_name": "NzRoutingContainer",
    "image": "../Dockerfile",
    "instance_type": "basic",
    "max_instances": 1
  }],
  "durable_objects": { "bindings": [{ "name": "NZ_ROUTING", "class_name": "NzRoutingContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NzRoutingContainer"] }]
}
