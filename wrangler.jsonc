{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "waybi",
	"account_id": "6b1d0dd4e6f7f30df92753cd1e2ee12d",
	"main": "apps/server/src/worker.ts",
	"workers_dev": true,
	"routes": [
		{ "pattern": "waybi.co/*", "zone_id": "85aece457d70df3d2aead8648c0f4c27" },
		{ "pattern": "www.waybi.co/*", "zone_id": "85aece457d70df3d2aead8648c0f4c27" }
	],
	"compatibility_date": "2026-08-04",
	"assets": {
		"directory": "apps/web/dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/*",
			"!/assets/*",
			"!/brand/*",
			"!/previews/*",
			"!/favicon.svg",
			"!/favicon.png",
			"!/og-waybi.png",
			"!/manifest.webmanifest",
			"!/sw.js",
			"!/registerSW.js",
			"!/workbox-*.js",
			"!/seo.css",
			"!/robots.txt",
			"!/sitemap.xml",
			"!/llms.txt",
			"!/waybi-indexnow-*"
		]
	},
	"vars": {
		"GOOGLE_MAP_ID": "ea4a0f74663866d5ba79ca1d",
		"WAYBI_NZ_ROUTING_URL": "https://waybi-nz-routing-ynu5h6oina-ts.a.run.app",
		"WAYBI_NZ_ROUTING_DAILY_LIMIT": "3000",
		"WAYBI_GOOGLE_SEARCH_ENABLED": "true"
	},
	"kv_namespaces": [
		{
			"binding": "CAMERA_DATA",
			"id": "e8e1988e112e4937aceab62ad01535e7"
		}
	],
	"d1_databases": [
		{
			"binding": "USER_DB",
			"database_name": "waybi-users",
			"database_id": "e766fccb-6e83-405a-a0a2-ad82e795153e"
		}
	],
	"triggers": {
		"crons": [
			"*/5 * * * *",
			"*/10 * * * *",
			"*/15 * * * *",
			"0 3 * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}
