{
  "name": "waybi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.6.0"
  },
  "scripts": {
    "dev": "pnpm build:web && concurrently -k -n server,web -c cyan,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @waybi/web dev",
    "dev:server": "pnpm --filter @waybi/server dev",
    "build": "pnpm build:web",
    "build:web": "pnpm --filter @waybi/core build && pnpm --filter @waybi/web build",
    "seo:check": "node scripts/seo-smoke.mjs",
    "check:worker": "pnpm --filter @waybi/server build",
    "test": "pnpm --filter @waybi/core test && pnpm --filter @waybi/server test",
    "data:traffic-geometry": "node scripts/refresh-traffic-geometry.mjs",
    "data:import": "node scripts/import-cameras.mjs",
    "db:migrate:local": "pnpm exec wrangler d1 migrations apply waybi-users --local --config wrangler.jsonc",
    "db:migrate:remote": "pnpm exec wrangler d1 migrations apply waybi-users --remote --config wrangler.jsonc",
    "start": "pnpm dev:server",
    "deploy": "pnpm build && pnpm exec wrangler deploy --config wrangler.jsonc",
    "mobile:doctor": "flutter doctor -v",
    "mobile:get": "cd apps/mobile && flutter pub get",
    "mobile:devices": "flutter devices",
    "mobile:emulators": "flutter emulators",
    "mobile:dev": "node scripts/flutter-dev.mjs",
    "mobile:run": "node scripts/flutter-dev.mjs",
    "mobile:analyze": "cd apps/mobile && flutter analyze",
    "mobile:test": "cd apps/mobile && flutter test",
    "mobile:build:apk": "cd apps/mobile && flutter build apk",
    "mobile:ios": "node scripts/ios-device.mjs debug",
    "mobile:ios:install": "node scripts/ios-device.mjs install",
    "mobile:ios:ipa": "node scripts/ios-device.mjs ipa",
    "typecheck:server": "pnpm --filter @waybi/server typecheck",
    "typecheck:nz-routing": "pnpm --filter @waybi/nz-routing typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.136.3"
  }
}
