<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/waybi_launch_background</item>
        <!-- Suppress the system's duplicate launcher icon; SplashGate draws the brand. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/waybi_launch_background</item>
    </style>
</resources>
