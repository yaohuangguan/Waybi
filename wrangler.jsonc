{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "waybi",
	"account_id": "cdc04de9bc4c6a41b5003758e505a0d1",
	"main": "apps/server/src/worker.ts",
	"workers_dev": true,
	"routes": [
		{ "pattern": "waybi.co", "custom_domain": true },
		{ "pattern": "www.waybi.co", "custom_domain": true }
	],
	"compatibility_date": "2026-08-04",
	"assets": {
		"directory": "apps/web/dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/*",
			"!/assets/*",
			"!/brand/*",
			"!/previews/*",
			"!/favicon.svg",
			"!/favicon.png",
			"!/og-waybi.png",
			"!/manifest.webmanifest",
			"!/sw.js",
			"!/registerSW.js",
			"!/workbox-*.js",
			"!/seo.css",
			"!/robots.txt",
			"!/sitemap.xml",
			"!/llms.txt",
			"!/waybi-indexnow-*"
		]
	},
	"vars": {
		"GOOGLE_MAP_ID": "ea4a0f74663866d5ba79ca1d"
	},
	"kv_namespaces": [
		{
			"binding": "CAMERA_DATA",
			"id": "c874d6e739824c52be53071c85c9e005"
		}
	],
	"d1_databases": [
		{
			"binding": "USER_DB",
			"database_name": "waybi-users",
			"database_id": "cd8e444b-d89e-452d-9ffe-9a0d9d7510f0"
		}
	],
	"triggers": {
		"crons": [
			"*/5 * * * *",
			"*/10 * * * *",
			"*/15 * * * *",
			"0 */6 * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}